// E() - Returns the mathematical constant e.
RETURN E() AS e_value; // Returns 2.718281828459045

// EXP() - Returns e raised to the power of a given number.
RETURN EXP(1) AS exp_value; // Returns 2.718281828459045

// LOG() - Returns the natural logarithm (base e) of a given number.
RETURN LOG(E()) AS log_value; // Returns 1

// LOG10() - Returns the base 10 logarithm of a given number.
RETURN LOG10(100) AS log10_value; // Returns 2

// SQRT() - Returns the square root of a given number.
RETURN SQRT(16) AS sqrt_value; // Returns 4
